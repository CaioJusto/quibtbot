{
  "name": "quibt-bot",
  "private": true,
  "version": "0.2.18",
  "homepage": "https://quibt.com.br",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "dev": "turbo dev --filter=@quibt/api --filter=@quibt/worker --filter=@quibt/web --filter=@quibt/sandbox-supervisor",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "lint:actions": "node scripts/lint-actions.mjs",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @quibt/db generate",
    "db:migrate": "pnpm --filter @quibt/db migrate",
    "owner:code": "node --env-file=.env scripts/mint-dev-owner-code.mjs",
    "sandbox:build": "docker build -t quibt/computer:local infra/sandboxes/computer",
    "release:manifest": "node scripts/release-version.mjs",
    "release:cli-binary": "node scripts/build-cli-binary.mjs",
    "verify:fast": "vitest run",
    "verify:install-pin": "node scripts/verify-install-script-pin.mjs",
    "verify:installer": "vitest run packages/installer apps/cli packages/testkit/src/installer-smoke.test.ts",
    "smoke:installer": "node scripts/smoke-installer.mjs",
    "verify": "tsx packages/testkit/src/cli/verify.ts",
    "verify:providers": "tsx packages/testkit/src/cli/verify.ts --providers",
    "e2e": "tsx packages/testkit/src/cli/verify.ts",
    "e2e:mobile": "pnpm --filter @quibt/mobile e2e",
    "compose:up": "docker compose -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose -f infra/compose/docker-compose.yml down -v",
    "desktop": "pnpm --filter @quibt/desktop dev",
    "desktop:pack": "node scripts/pack-desktop.mjs",
    "desktop:pack:mac": "node scripts/pack-desktop.mjs mac",
    "desktop:pack:win": "node scripts/pack-desktop.mjs win",
    "desktop:pack:linux": "node scripts/pack-desktop.mjs linux",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:chat": "node --env-file-if-exists=.env scripts/dev-chat.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.3.0",
    "actionlint": "^2.0.6",
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.5",
    "turbo": "^2.10.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "cpu-features",
      "electron-winstaller",
      "esbuild",
      "prisma",
      "protobufjs",
      "ssh2"
    ],
    "ignoredBuiltDependencies": [
      "@google/genai",
      "onnxruntime-node"
    ],
    "overrides": {
      "adm-zip": "0.6.0",
      "decode-uri-component": "0.5.0",
      "deepmerge-ts": "8.0.2",
      "mysql2": "3.22.0",
      "postcss": "8.5.26",
      "sharp": "0.35.3",
      "uuid": "11.1.1"
    },
    "patchedDependencies": {
      "@dylankenneally/react-native-ssh-sftp@1.11.0": "patches/@dylankenneally__react-native-ssh-sftp@1.11.0.patch"
    }
  }
}
