# syntax=docker/dockerfile:1

# Reproducible Linux SEA builder used when hosted release runners are unavailable.
# The build happens inside the requested native Linux architecture and pins the
# embedded Compose manifest to the exact release image digests without editing
# the developer checkout.
FROM node:26.8-bookworm@sha256:9f94d34c787165dca03b74e5bf9c3bf90e8de79b19aa3d87fe1fa1694bf75c89 AS build

ENV ONNXRUNTIME_NODE_INSTALL=skip
RUN corepack enable
WORKDIR /src

COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter . --filter @quibt/cli...

ARG RELEASE_VERSION
ARG STACK_DIGEST
ARG SUPERVISOR_DIGEST
ARG COMPUTER_DIGEST

RUN node scripts/pin-release-images.mjs \
      --stack "${STACK_DIGEST}" \
      --supervisor "${SUPERVISOR_DIGEST}" \
      --computer "${COMPUTER_DIGEST}" && \
    node scripts/build-cli-binary.mjs --release "${RELEASE_VERSION}" --out /release

FROM scratch
COPY --from=build /release/ /
