+  private static String normalizeSha256Fingerprint(String input) {
+    if (input == null) return "";
+    String trimmed = input.trim();
+    if (trimmed.isEmpty()) return "";
+    if (trimmed.matches("(?i)^SHA256:[A-Za-z0-9+/=]+$")) {
+      return trimmed.replaceAll("=+$", "").replaceFirst("(?i)^SHA256:", "SHA256:");
+    }
+    if (trimmed.matches("(?i)^[a-f0-9]{64}$")) {
+      try {
+        byte[] bytes = new byte[32];
+        for (int i = 0; i < 32; i++) {
+          bytes[i] = (byte) Integer.parseInt(trimmed.substring(i * 2, i * 2 + 2), 16);
+        }
+        String base64 = Base64.encodeToString(bytes, Base64.NO_WRAP).replaceAll("=+$", "");
+        return "SHA256:" + base64;
+      } catch (Exception error) {
+        return trimmed;
+      }
+    }
+    return trimmed;
+  }
+
+  private static String sha256Fingerprint(byte[] key) throws Exception {
+    MessageDigest digest = MessageDigest.getInstance("SHA-256");
+    byte[] hash = digest.digest(key);
+    String base64 = Base64.encodeToString(hash, Base64.NO_WRAP).replaceAll("=+$", "");
+    return "SHA256:" + base64;
+  }
+
+  private static String detectHostKeyAlgorithm(byte[] key) {
+    if (key == null || key.length < 8) return "unknown";
+    int typeLen = ((key[0] & 0xff) << 24) | ((key[1] & 0xff) << 16) | ((key[2] & 0xff) << 8) | (key[3] & 0xff);
+    if (typeLen <= 0 || 4 + typeLen > key.length) return "unknown";
+    return new String(key, 4, typeLen, StandardCharsets.UTF_8).trim();
+  }
