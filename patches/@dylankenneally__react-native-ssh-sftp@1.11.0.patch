+RCT_EXPORT_METHOD(inspectHostKey:(NSString *)host
+                  port:(NSInteger)port
+                  resolver:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject)
+{
+    dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+        NMSSHSession *session = [NMSSHSession connectToHost:host port:port withUsername:@"quibt-fingerprint-probe"];
+        if (!session || !session.isConnected) {
+            reject(@"inspect_failed", session.lastError.localizedDescription ?: @"SSH connection failed", nil);
+            return;
+        }
+        size_t hostKeyLength = 0;
+        const char *hostKeyBytes = libssh2_session_hostkey(session.rawSession, &hostKeyLength, NULL);
+        NSData *hostKey = (hostKeyBytes && hostKeyLength > 0)
+            ? [NSData dataWithBytes:hostKeyBytes length:hostKeyLength]
+            : nil;
+        if (!hostKey) {
+            [session disconnect];
+            reject(@"inspect_failed", @"SSH host fingerprint was not returned", nil);
+            return;
+        }
+        NSString *algorithm = @"unknown";
+        if (hostKey.length > 4) {
+            const unsigned char *bytes = hostKey.bytes;
+            uint32_t typeLen = CFSwapInt32BigToHost(*(uint32_t *)bytes);
+            if (typeLen > 0 && 4 + typeLen <= hostKey.length) {
+                algorithm = [[NSString alloc] initWithBytes:bytes + 4 length:typeLen encoding:NSUTF8StringEncoding];
+            }
+        }
+        NSString *fingerprint = QBSha256Fingerprint(hostKey);
+        [session disconnect];
+        resolve(@{@"algorithm": algorithm ?: @"unknown", @"fingerprint": fingerprint});
+    });
+}
+
+RCT_EXPORT_METHOD(connectVerifiedHost:(NSString *)host
+                  port:(NSInteger)port
+                  username:(NSString *)username
+                  expectedFingerprint:(NSString *)expectedFingerprint
+                  auth:(NSDictionary *)auth
+                  resolver:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject)
+{
+    NSString *expected = QBNormalizeSha256Fingerprint(expectedFingerprint);
+    if (expected.length == 0) {
+        reject(@"fingerprint_required", @"Expected SSH host fingerprint is required.", nil);
+        return;
+    }
+
+    dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+        NMSSHSession *session = [NMSSHSession connectToHost:host port:port withUsername:username];
+        if (!session || !session.isConnected) {
+            reject(@"connect_failed", @"SSH connection failed", nil);
+            return;
+        }
+
+        size_t hostKeyLength = 0;
+        const char *hostKeyBytes = libssh2_session_hostkey(session.rawSession, &hostKeyLength, NULL);
+        NSData *hostKey = (hostKeyBytes && hostKeyLength > 0)
+            ? [NSData dataWithBytes:hostKeyBytes length:hostKeyLength]
+            : nil;
+        if (!hostKey || ![QBSha256Fingerprint(hostKey) isEqualToString:expected]) {
+            [session disconnect];
+            reject(@"connect_failed", @"SSH host fingerprint mismatch", nil);
+            return;
+        }
+
+        NSString *password = auth[@"password"];
+        BOOL authorized = NO;
+        if (password) {
+            authorized = [session authenticateByPassword:password];
+        } else if (auth[@"privateKey"]) {
+            authorized = [session authenticateByInMemoryPublicKey:nil
+                                                       privateKey:auth[@"privateKey"]
+                                                      andPassword:auth[@"passphrase"]];
+        }
+
+        if (!authorized) {
+            [session disconnect];
+            reject(@"connect_failed", @"SSH authentication failed", nil);
+            return;
+        }
+
+        NSString *clientKey = [NSString stringWithFormat:@"verified_%f", CFAbsoluteTimeGetCurrent()];
+        SSHClient* client = [[SSHClient alloc] init];
+        client._session = session;
+        client._key = clientKey;
+        [[self clientPool] setObject:client forKey:clientKey];
+        resolve(clientKey);
+    });
+}
+
+RCT_EXPORT_METHOD(disconnectVerified:(nonnull NSString*)key
+                  resolver:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject)
+{
+    [self disconnect:key];
+    resolve(nil);
+}
