# Só para o `pnpm dev` nesta máquina de desenvolvimento. O Compose ignora este valor: os
# serviços api, worker, web e supervisor fixam NODE_ENV=production no próprio arquivo, porque
# `development` num servidor aceitaria segredos de exemplo, derivaria o token do supervisor do
# segredo de sessão e deixaria o CORS aceitar qualquer localhost com credenciais.
NODE_ENV=development
DATABASE_URL=postgres://quibt:quibt@127.0.0.1:5433/quibt
# Prazo de uma transação do Prisma, em ms (padrão 30000). O padrão do Prisma, 5 s, abortava
# apagar um bot ou uma conta com muito histórico — e o computador já tinha sido destruído no
# provedor. Aumente se o seu banco for grande e essas operações ainda estourarem o prazo.
DATABASE_TRANSACTION_TIMEOUT_MS=30000
# Conexões que cada processo (API e worker) abre no Postgres. Padrão 16: o driver `pg` não lê
# `max` da URL, e uma tela de conversa dispara até 7 consultas juntas. Aumente se muita gente
# usa o app ao mesmo tempo e as consultas ficam esperando; diminua se o seu Postgres tem um
# `max_connections` apertado (cada processo abre até este número).
DATABASE_POOL_MAX=16
# Troque os dois valores `replace-with-...` abaixo antes de subir o Compose: qualquer valor que
# comece com `replace-with-` é recusado no boot fora de development/test. Gere cada um com
# `openssl rand -hex 32`.
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret # gitleaks:allow -- documented rejected placeholder
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
WEB_ORIGIN=http://127.0.0.1:5173
# Additional browser origins allowed by CORS/auth, comma-separated. Loopback is not implicit in production.
TRUSTED_WEB_ORIGINS=
# Transport IPs of reverse proxies allowed to supply X-Real-IP/X-Forwarded-For.
TRUSTED_PROXY_IPS=
# O cadastro nasce fechado: só o primeiro dono entra (pelo código do instalador). Numa VPS
# pública, aberto deixaria qualquer pessoa criar conta, ganhar um computador com Chrome e
# gastar a sua chave. Para aceitar outras contas, troque para true e reinicie a API.
SIGNUPS_ENABLED=false
SIGNUP_ALLOWLIST=
ENCRYPTION_KEY=replace-with-64-char-hex-or-passphrase
DATA_DIR=./data
SANDBOX_SUPERVISOR_URL=http://127.0.0.1:7091
# Shared credential between API, worker and the sandbox supervisor. Required in production:
# whoever holds it can create containers and run commands in any workspace, so it must be its
# own long random string, not BETTER_AUTH_SECRET. Left empty outside production, the services
# derive a token from BETTER_AUTH_SECRET so local dev keeps working. The Compose stack runs as
# production, so fill this in (`openssl rand -hex 32`) before `docker compose up`.
SANDBOX_SUPERVISOR_TOKEN=
# Fallback machine: used when the deployment owner never picked one in onboarding.
SANDBOX_PROVIDER=docker
# Put each workspace computer on its own Docker network, away from Postgres and the app.
# infra/compose sets this for you; set it by hand on any host that also runs the database.
# SANDBOX_SCREEN_NETWORK=internal
AGENT_RUNTIME=pi
WAKEUP_DRIVER=graphile
# Pause E2B (or stop Docker) computers after this many idle ms. Minimum 30000.
SANDBOX_IDLE_MS=600000
# Stop a shell command after this many ms. Default 5 minutes, maximum 1 hour.
SANDBOX_COMMAND_TIMEOUT_MS=300000
OPENROUTER_API_KEY=
PI_DEFAULT_PROVIDER=openrouter
PI_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731
E2B_API_KEY=
BOX_API_KEY=
# Optional: a supervisor already running on another host (BYO VPS).
SANDBOX_REMOTE_SUPERVISOR_URL=
SANDBOX_REMOTE_SUPERVISOR_TOKEN=
# Optional. Leave empty and paste the key in Plugins → Apps inside the app instead.
COMPOSIO_API_KEY=
# Auth e-mail (Resend). Required in production unless self-host opts out below.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Quibt Bot <noreply@quibt.com.br>
# Self-host production only. Cannot be true when BILLING_ENABLED=true.
AUTH_EMAIL_DISABLED=false
# Loopback-only bootstrap invite minting. Separate from BETTER_AUTH_SECRET; never ship to clients.
BOOTSTRAP_SECRET=
# Landing (apps/www) → app logado
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
# Desktop Electron
QUIBT_WEB_URL=http://127.0.0.1:5173
# App iOS / Expo
EXPO_PUBLIC_API_URL=http://127.0.0.1:3100
EXPO_PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173
EXPO_PUBLIC_PROJECT_ID=
# Open-source product. Leave these as-is for local and self-host.
QUIBT_EDITION=oss
BILLING_ENABLED=false
# QUIBT_ALLOW_SHARED_DOCKER=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Onde ficam os arquivos trocados no chat (prints, PDFs, planilhas, recados de voz).
# Vazio usa ./data/artifacts ao lado da API.
ARTIFACTS_DIR=
